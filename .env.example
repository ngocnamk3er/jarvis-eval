# --- How to reach the deployed test cluster -------------------------------
# Everything is vhost-routed off one ingress IP; the harness sends a Host:
# header per service (same trick as curl --resolve). Point INGRESS_IP at
# `minikube ip -p minikube`.
INGRESS_IP=192.168.49.2
API_HOST=api.jarvis.local
AUTH_HOST=auth.jarvis.local

# Keycloak — password grant for the eval user, admin API to create it.
KC_REALM=jarvis
KC_CLIENT_ID=jarvis-frontend
KC_CLIENT_SECRET=jarvis-dev-secret
EVAL_USERNAME=eval
EVAL_PASSWORD=eval123
# From the jarvis-keycloak-secrets k8s secret (KC_BOOTSTRAP_ADMIN_*).
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=admin

# file-service is ClusterIP-only. Run `make port-forward` (kubectl
# port-forward svc/file-service 18002:8000 -n jarvis) and leave this as-is.
FILE_SERVICE_URL=http://localhost:18002
# From the jarvis-secrets k8s secret (INTERNAL_API_KEY) — needed for
# file-service /search/* which is not proxied by the backend.
INTERNAL_API_KEY=changeme-dev-only

# --- Models --------------------------------------------------------------
# Model the agent runs as during eval (a ChatRequest.model id — see
# jarvis-backend AVAILABLE_MODELS). Default = the product default.
RUNNER_MODEL=deepseek/deepseek-v4-flash
RUNNER_THINKING_EFFORT=high
# LLM-as-judge. Needs an OpenRouter key (reuse the one in jarvis-secrets).
JUDGE_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Run behaviour ------------------------------------------------------
# Max bash-approval rounds to auto-approve before giving up on a case.
MAX_HITL_ROUNDS=8
# Default repeats per case (CLI --repeats overrides).
REPEATS=1
# Per-agent-run wall-clock ceiling (seconds).
RUN_TIMEOUT=420
